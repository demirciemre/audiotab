# vc.py ayarları (claude-code-version-control-skill). Bu dosya çalıştırılmaz, yalnızca okunur.
# SCHEME: semver (v1.2.3) | counter (mockup-v12). TEST_CMD boşsa release --verified ister.
TAG_PREFIX="v"
SCHEME="semver"
TEST_CMD=""
COMMIT_LINT="warn"
REMOTE="origin"
# GitHub Release'i CI açar, AudioTab.zip ile birlikte: zip'siz sürüm güncelleyicide görünmesin
GH_RELEASE="false"
LANG="tr"
CHANGELOG="CHANGELOG.md"
VERSION_FILE="VERSION"
